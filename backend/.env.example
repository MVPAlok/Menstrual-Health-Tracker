# NariCare Backend Environment Variables Template
# Copy this file to backend/.env and replace placeholders with your actual secret credentials.
# DO NOT commit real backend/.env files to git repositories.

# Database Connection Strings (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret Key for JWT Token Signatures
JWT_SECRET="generate_a_random_32_character_secret_key_here"

# Server Port
PORT=5000

# Client Application URL (CORS origin)
CLIENT_URL="http://localhost:5173"

# Redis Server URL
REDIS_URL="redis://127.0.0.1:6379"
